{
  "name": "@lykosjs/cloudinary",
  "version": "0.0.1",
  "description": "A type-safe Cloudinary integration for uploading, managing, and deleting images, files, and videos in LykosJS applications",
  "license": "MIT",
  "author": "Zen Allaham <zenallaham09@gmail.com> (https://zenallaham.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "lykosjs",
    "cloudinary",
    "image-upload",
    "upload",
    "images"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cloudinary": "^2.5.1"
  },
  "peerDependencies": {
    "lykosjs": "^0.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lykosjs": "^0.0.2",
    "typescript": "^7.0.2"
  }
}
